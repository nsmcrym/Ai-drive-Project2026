<!doctype html>
<html lang="ja">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AI質問</title>
    <style>
        #ai-answer,
        #ai-history li p {
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }
    </style>
    <script src="/ai/ai.js" defer></script>
</head>
<body>
    <main>
        <h1>AI質問</h1>
        <nav aria-label="戻り先">
            <a href="/">トップ</a> · <a href="/todo">TODO</a> · <a href="/todo-v2">TODO V2</a>
        </nav>
        <section aria-labelledby="ai-ask-heading">
            <h2 id="ai-ask-heading">質問を送る</h2>
            <form id="ai-ask-form">
                <label for="ai-prompt">質問（1〜2,000文字）</label>
                <textarea id="ai-prompt" rows="5" required></textarea>
                <button id="ai-ask-submit" type="submit" disabled>送信</button>
            </form>
            <p id="ai-ask-status" role="status"></p>
            <p id="ai-ask-error" role="alert"></p>
            <section id="ai-answer-section" aria-labelledby="ai-answer-heading" hidden>
                <h3 id="ai-answer-heading">回答</h3>
                <p id="ai-answer"></p>
            </section>
        </section>
        <section aria-labelledby="ai-history-heading">
            <h2 id="ai-history-heading">質問履歴</h2>
            <button id="ai-history-refresh" type="button" disabled>履歴を更新</button>
            <p id="ai-history-status" role="status"></p>
            <p id="ai-history-error" role="alert"></p>
            <ol id="ai-history"></ol>
        </section>
    </main>
</body>
</html>
