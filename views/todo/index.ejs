<!doctype html>
<html lang="ja">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>TODO</title>
    <script src="/todo/todo.js" defer></script>
</head>
<body>
    <main id="todo-app">
        <h1>TODO</h1>
        <p><a href="/">トップへ戻る</a></p>
        <fieldset id="todo-controls" disabled>
            <legend>TODOの管理</legend>
            <form id="todo-form">
                <label for="todo-title">タイトル</label>
                <input id="todo-title" name="title" maxlength="100" required>
                <button type="submit">追加</button>
            </form>
            <p id="todo-empty" hidden>TODOがありません</p>
            <ul id="todo-list" aria-label="TODO一覧"></ul>
        </fieldset>
        <p id="todo-status" role="status"></p>
        <p id="todo-error" role="alert"></p>
    </main>
</body>
</html>
